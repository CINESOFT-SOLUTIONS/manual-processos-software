    rectangle "1.1.1 Auth RBAC & Cripto CPF" as M1_1
    rectangle "1.1.2 Back-office: Sessões e Salas" as M1_2
    rectangle "1.1.3 Bilheteria ACID Anti-Double-Booking" as M1_3

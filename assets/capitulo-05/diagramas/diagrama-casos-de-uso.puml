@startuml
left to right direction

skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Arial"
skinparam defaultFontSize 11
skinparam defaultFontColor #111111
skinparam defaultTextAlignment center

skinparam nodesep 22
skinparam ranksep 65
skinparam padding 6

skinparam actorStyle awesome
skinparam actor {
    BackgroundColor #F4F4F5
    BorderColor #71717A
    FontColor #111111
}

skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #888888
    BorderThickness 1
    FontColor #333333
}

skinparam usecase {
    BackgroundColor #F4F4F5
    BorderColor #71717A
    BorderThickness 1
    FontColor #111111
}

skinparam arrow {
    Color #27272A
    Thickness 1.1
}

actor "Espectador\n(Cliente Final)" as Esp
actor "Atendente\n(Guichê Físico)" as Atd
actor "Gerente\n(Back-office)" as Ger

rectangle "Sistema SaaS Multi-Tenant CineDoom" {
    usecase "Ver catálogo e horários" as UC1
    usecase "Cadastrar conta e consentimento LGPD" as UC2
    usecase "Fazer reserva online + voucher" as UC3
    usecase "Cancelar reserva pelo site" as UC4
    usecase "Vender ingresso no balcão" as UC5
    usecase "Encontrar reserva pelo código" as UC6
    usecase "Cancelar ingresso no guichê" as UC7
    usecase "Gerenciar filmes, salas e sessões" as UC8
    usecase "Gerenciar atendentes e ocupação" as UC9
    usecase "Anonimizar dados LGPD" as UC10
}

Esp --> UC1
Esp --> UC2
Esp --> UC3
Esp --> UC4

Atd --> UC1
Atd --> UC5
Atd --> UC6
Atd --> UC7

Ger --> UC8
Ger --> UC9
Ger --> UC10

@enduml
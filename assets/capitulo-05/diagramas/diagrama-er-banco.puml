@startuml diagrama-er-banco
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Helvetica
skinparam defaultFontSize 10
skinparam roundCorner 4
skinparam shadowing false
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #1A1A2E
  ArrowColor #1A1A2E
  FontColor #1A1A2E
  HeaderBackgroundColor #F4F6F9
}

entity "users" as users {
  * id : uuid <<PK>>
  --
  email : varchar(255)
  password_hash : varchar(255)
  full_name : varchar(150)
  role : varchar(50)
  created_at : timestamp
}

entity "sessions" as sessions {
  * id : uuid <<PK>>
  --
  movie_id : uuid <<FK>>
  room_id : uuid <<FK>>
  start_time : timestamp
  end_time : timestamp
  price_standard : decimal(10,2)
  status : varchar(30)
}

entity "movies" as movies {
  * id : uuid <<PK>>
  --
  title : varchar(200)
  duration_minutes : integer
  classification : varchar(10)
  genre : varchar(50)
}

entity "rooms" as rooms {
  * id : uuid <<PK>>
  --
  name : varchar(50)
  capacity : integer
  technology : varchar(50)
}

entity "seats" as seats {
  * id : uuid <<PK>>
  --
  room_id : uuid <<FK>>
  row_code : varchar(5)
  number : integer
  seat_type : varchar(30)
}

entity "tickets" as tickets {
  * id : uuid <<PK>>
  --
  session_id : uuid <<FK>>
  seat_id : uuid <<FK>>
  order_id : uuid <<FK>>
  price_paid : decimal(10,2)
  status : varchar(30)
}

entity "orders" as orders {
  * id : uuid <<PK>>
  --
  user_id : uuid <<FK>>
  total_amount : decimal(10,2)
  payment_method : varchar(50)
  status : varchar(30)
  created_at : timestamp
}

movies ||..o{ sessions : "exibe em"
rooms ||..o{ sessions : "aloca"
rooms ||..o{ seats : "contém"
sessions ||..o{ tickets : "possui"
seats ||..o{ tickets : "reserva"
orders ||..o{ tickets : "contém"
users ||..o{ orders : "realiza"
@enduml
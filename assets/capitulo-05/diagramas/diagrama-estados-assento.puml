@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Helvetica

[*] --> DISPONIVEL
DISPONIVEL --> HOLD : Cliente seleciona no portal web
HOLD --> DISPONIVEL : Timeout (10 min) ou cancelamento
HOLD --> CONFIRMED : Pagamento presencial ou PIX
DISPONIVEL --> CONFIRMED : Venda avulsa direta no guichê
CONFIRMED --> [*]
@enduml

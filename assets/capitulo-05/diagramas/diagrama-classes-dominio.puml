@startuml
top to bottom direction

skinparam shadowing false
skinparam roundCorner 0
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Arial"
skinparam defaultFontSize 11
skinparam defaultFontColor #111111

skinparam nodesep 45
skinparam ranksep 55
skinparam linetype polyline
skinparam classAttributeIconSize 0

hide circle
hide empty methods

skinparam class {
    BackgroundColor #FFFFFF
    HeaderBackgroundColor #F4F4F5
    BorderColor #71717A
    BorderThickness 1
    FontColor #111111
    FontStyle bold
    AttributeFontColor #111111
    AttributeFontSize 10
}

skinparam arrow {
    Color #27272A
    FontColor #111111
    FontSize 10
    Thickness 1.1
}

class Tenant {
    +UUID id
    +String name
    +String slug
    +Boolean active
}

class User {
    +UUID id
    +UUID tenantId
    +String name
    +String email
    +String passwordHash
    +Role role
    +String cpfHash
    +String cpfEncrypted
    +Boolean active
}

class Film {
    +UUID id
    +UUID tenantId
    +String title
    +String synopsis
    +String genre
    +Int duration
    +String classification
    +String posterUrl
}

class Room {
    +UUID id
    +UUID tenantId
    +String name
    +Int rows
    +Int columns
    +Int capacity
}

class Seat {
    +UUID id
    +UUID roomId
    +String rowLabel
    +Int number
    +String seatCode
}

class Session {
    +UUID id
    +UUID tenantId
    +UUID filmId
    +UUID roomId
    +DateTime startsAt
    +Decimal price
}

class SessionSeat {
    +UUID id
    +UUID sessionId
    +UUID seatId
    +SessionSeatStatus status
    +UUID reservationId
}

class Reservation {
    +UUID id
    +String code
    +UUID tenantId
    +UUID sessionId
    +UUID userId
    +ReservationStatus status
    +Decimal totalPrice
    +DateTime expiresAt
    +DateTime emailSentAt
}

class Ticket {
    +UUID id
    +UUID tenantId
    +UUID sessionSeatId
    +UUID operatorId
    +TicketStatus status
    +Decimal pricePaid
    +String buyerCpfHash
}

Tenant "1" --> "*" User : possui
Tenant "1" --> "*" Film : mantém
Tenant "1" --> "*" Room : gerencia
Room "1" *-- "*" Seat : contém
Film "1" --> "*" Session : exibido em
Room "1" --> "*" Session : sedia
Session "1" *-- "*" SessionSeat : pré-popula
Seat "1" --> "*" SessionSeat : referencia
Reservation "1" --> "1..5" SessionSeat : bloqueia
SessionSeat "1" --> "0..1" Ticket : gera

@enduml